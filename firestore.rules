rules_version = '2';

/**
 * Reglas de Firestore para el Control de Fichadas.
 *
 * Pegalas en: consola de Firebase → Firestore Database → Reglas → Publicar.
 *
 * Version corta. La unica regla que no se puede aflojar es que el acceso
 * exige un documento en usuarios/{uid}: la apiKey es publica, asi que
 * cualquiera puede crearse una cuenta llamando a la API de Firebase por
 * fuera de la pagina. Tener cuenta no es tener acceso; el documento de
 * usuario es lo que lo habilita.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Sesion abierta, con perfil cargado y no desactivado.
    function habilitado() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfil().activo == true;
    }

    function esAdmin() {
      return habilitado() && perfil().rol == 'admin';
    }

    // Todavia no se creo el administrador inicial.
    function sinInicializar() {
      return !exists(/databases/$(database)/documents/config/sistema);
    }

    // Centinela de puesta en marcha. Se lee sin login para que la pantalla
    // de acceso sepa si tiene que ofrecer "crear el primer administrador".
    match /config/sistema {
      allow read: if true;
      allow create: if request.auth != null && sinInicializar();
      allow update, delete: if false;
    }

    match /usuarios/{uid} {
      // Cada uno lee su propio perfil (el login necesita saber el rol).
      // El admin lee la lista completa.
      allow get: if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow list: if esAdmin();

      // Alta: el admin crea usuarios. La excepcion es el primer
      // administrador, que se crea a si mismo mientras no exista el centinela.
      allow create: if esAdmin()
        || (request.auth != null && request.auth.uid == uid && sinInicializar());

      allow update: if esAdmin();

      // Borrar dejaria la cuenta de Authentication huerfana: se desactiva.
      allow delete: if false;
    }

    match /empleados/{legajo} {
      allow read: if habilitado();
      allow write: if esAdmin();
    }

    // Todo lo que no este declarado arriba queda cerrado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
